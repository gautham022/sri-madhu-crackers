# ===== Copy to .env.local and fill in before deploying to AWS =====

# Auth secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# Admin phone numbers (10-digit, comma separated) - these can login as Admin via OTP
ADMIN_PHONES=9600331523

# --- SMS OTP provider (optional now; add later for real OTP SMS) ---
# SMS_PROVIDER=fast2sms
# FAST2SMS_KEY=
# (or) SMS_PROVIDER=msg91
# MSG91_KEY=
# MSG91_TEMPLATE=

# --- Razorpay (add keys to enable real online payments) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- AWS DynamoDB (leave unset in dev to use local files) ---
# AWS_REGION=ap-south-1
# DYNAMO_TABLE=sri-madhu-crackers
# (credentials via AWS CLI `aws configure` or IAM role on EC2/ECS)
